// Sinew data model. Mirrors docs/BRIEF.md §5.
//
// Conventions
// - Every user-owned row carries `userId` (directly or through its parent) and every
//   query goes through a helper that scopes by the session user (see src/lib/db/scoped.ts).
// - IDs are strings generated by the client (UUID v4) for anything that can be created
//   offline (sessions, entries, sets, bodyweight), so local-first rows keep their id on sync.
// - Log rows have `updatedAt` + `deletedAt` (tombstones) to support last-write-wins sync.
// - A session copies its planned targets when it is created: editing the program never
//   rewrites history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (better-auth) ──────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  timezone      String   @default("America/Edmonton")
  // Settings (deload is a setting, never a fixed date)
  deloadEnabled      Boolean @default(true)
  deloadEveryWeeks   Int     @default(4)
  createdAt     DateTime @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)

  sessions          Session[]
  accounts          Account[]
  exercises         Exercise[]
  progressionChains ProgressionChain[]
  templates         SessionTemplate[]
  programs          Program[]
  workouts          WorkoutSession[]
  bodyweights       BodyweightLog[]
  importBatches     ImportBatch[]
  gtgLogs           GtgLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(3)
  updatedAt             DateTime  @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime? @db.Timestamptz(3)
  updatedAt  DateTime? @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ─── Library & program ──────────────────────────────────────────────────────

enum ExerciseKind {
  reps
  hold
}

enum TargetUnit {
  reps
  sec
}

model Exercise {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  /// Normalised name (see domain/exercise-matching.ts). Unique per user so names never split.
  normalizedName     String
  aliases            String[]      @default([])
  kind               ExerciseKind
  perSide            Boolean       @default(false)
  allowsWeight       Boolean       @default(false)
  allowsAssistance   Boolean       @default(false)
  progressionChainId String?
  progressionChain   ProgressionChain? @relation(fields: [progressionChainId], references: [id], onDelete: SetNull)
  notes              String?
  /// Retire, don't delete (P1 9b). Archived exercises stay searchable.
  archivedAt         DateTime?     @db.Timestamptz(3)
  archivedReason     String?
  replacedById       String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  plannedIn PlannedExercise[] @relation("planned")
  altIn     PlannedExercise[] @relation("alt")
  entries   ExerciseEntry[]
  chainSteps ProgressionStep[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@map("exercise")
}

model ProgressionChain {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  steps     ProgressionStep[]
  exercises Exercise[]
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([userId, name])
  @@map("progression_chain")
}

model ProgressionStep {
  id         String           @id @default(uuid())
  chainId    String
  chain      ProgressionChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  order      Int
  label      String
  exerciseId String?
  exercise   Exercise?        @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  entries    ExerciseEntry[]

  @@unique([chainId, order])
  @@map("progression_step")
}

enum PartKind {
  pull
  push
  legs
  core
  other
}

model SessionTemplate {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. "Pull B → Core B"
  name      String
  parts     TemplatePart[]
  days      ProgramDay[]
  workouts  WorkoutSession[]
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("session_template")
}

model TemplatePart {
  id         String            @id @default(uuid())
  templateId String
  template   SessionTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order      Int
  name       String
  kind       PartKind
  goal       String?
  /// Warm-up key (see domain/program.seed.ts warmups)
  warmupKey  String?
  items      PlannedExercise[]

  @@unique([templateId, order])
  @@map("template_part")
}

model PlannedExercise {
  id            String         @id @default(uuid())
  partId        String
  part          TemplatePart   @relation(fields: [partId], references: [id], onDelete: Cascade)
  order         Int
  exerciseId    String
  exercise      Exercise       @relation("planned", fields: [exerciseId], references: [id])
  altExerciseId String?
  altExercise   Exercise?      @relation("alt", fields: [altExerciseId], references: [id], onDelete: SetNull)
  sets          Int
  targetMin     Int
  targetMax     Int?
  targetUnit    TargetUnit
  /// Current per-set goal inside the range (progression moves it). Null = targetMin.
  workingTarget Int?
  /// Cap for set progression. Null = domain default.
  maxSets       Int?
  restSec       Int?
  /// Upper bound when the program gives a range ("2–3 min")
  restMaxSec    Int?
  notes         String?
  supersetGroup String?
  changes       TargetChange[]

  @@unique([partId, order])
  @@map("planned_exercise")
}

/// Versioned target history (P1 #9): when and how each target evolved.
model TargetChange {
  id                String          @id @default(uuid())
  plannedExerciseId String
  plannedExercise   PlannedExercise @relation(fields: [plannedExerciseId], references: [id], onDelete: Cascade)
  effectiveFrom     DateTime        @db.Date
  sets              Int
  targetMin         Int
  targetMax         Int?
  workingTarget     Int?
  reason            String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([plannedExerciseId, effectiveFrom])
  @@map("target_change")
}

model Program {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean      @default(true)
  days      ProgramDay[]
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@index([userId, active])
  @@map("program")
}

/// weekday: 0 = Monday … 6 = Sunday. templateId null = rest day.
model ProgramDay {
  id         String           @id @default(uuid())
  programId  String
  program    Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekday    Int
  templateId String?
  template   SessionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([programId, weekday])
  @@map("program_day")
}

// ─── Log (what the notebook records) ────────────────────────────────────────

enum SessionSource {
  app
  import
}

enum Discomfort {
  none
  mild
  pain
}

model WorkoutSession {
  id            String          @id
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Local calendar date of the session (no time zone games)
  date          DateTime        @db.Date
  startedAt     DateTime?       @db.Timestamptz(3)
  endedAt       DateTime?       @db.Timestamptz(3)
  templateId    String?
  template      SessionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title         String?
  sessionNotes  String?
  discomfort    Discomfort?
  discomfortNote String?
  isDeload      Boolean         @default(false)
  source        SessionSource   @default(app)
  importBatchId String?
  importBatch   ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  entries       ExerciseEntry[]
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?       @db.Timestamptz(3)
  /// Client clock of the last edit. Last-write-wins sync compares this, not server time.
  clientUpdatedAt DateTime?     @db.Timestamptz(3)

  @@index([userId, date])
  @@index([userId, updatedAt])
  @@map("workout_session")
}

model ExerciseEntry {
  id               String           @id
  sessionId        String
  session          WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise         @relation(fields: [exerciseId], references: [id])
  order            Int
  partName         String?
  supersetGroup    String?
  // Copied at session time — history never changes if the program is edited
  plannedSets      Int?
  plannedTargetMin Int?
  plannedTargetMax Int?
  plannedUnit      TargetUnit?
  plannedWorking   Int?
  restSec          Int?
  breakAfterSec    Int?
  notes            String?
  variationStepId  String?
  variationStep    ProgressionStep? @relation(fields: [variationStepId], references: [id], onDelete: SetNull)
  discomfort       Discomfort?
  discomfortNote   String?
  sets             SetEntry[]

  @@unique([sessionId, order])
  @@index([exerciseId])
  @@map("exercise_entry")
}

enum Side {
  L
  R
}

enum AssistanceType {
  band
  machine
}

model SetEntry {
  id              String          @id
  entryId         String
  entry           ExerciseEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  index           Int
  value           Int
  unit            TargetUnit
  side            Side?
  weightKg        Decimal?        @db.Decimal(6, 2)
  assistanceType  AssistanceType?
  assistanceLabel String?
  assistanceKg    Decimal?        @db.Decimal(6, 2)
  rir             Int?
  clean           Boolean?
  restActualSec   Int?
  note            String?

  @@unique([entryId, index, side])
  @@map("set_entry")
}

model BodyweightLog {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  kg        Decimal   @db.Decimal(5, 2)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@unique([userId, date])
  @@map("bodyweight_log")
}

/// Handstand grease-the-groove: lightweight daily counter, not part of a session.
model GtgLog {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  seconds   Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, date])
  @@map("gtg_log")
}

// ─── Import ──────────────────────────────────────────────────────────────────

enum ImportKind {
  file
  photo
  quick_entry
}

enum ImportStatus {
  draft
  processing
  needs_review
  committed
  undone
  failed
}

enum ImportImageStatus {
  queued
  parsed
  needs_review
  confirmed
  failed
}

model ImportBatch {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       ImportKind
  sourceName String?
  rowCount   Int              @default(0)
  status     ImportStatus     @default(draft)
  summary    Json?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  committedAt DateTime?       @db.Timestamptz(3)
  undoneAt   DateTime?        @db.Timestamptz(3)
  sessions   WorkoutSession[]
  images     ImportImage[]

  @@index([userId, createdAt])
  @@map("import_batch")
}

model ImportImage {
  id              String            @id @default(uuid())
  batchId         String
  batch           ImportBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// Private storage key (never a public URL)
  storagePath     String
  order           Int               @default(0)
  /// Pages of the same notebook session share a group
  sessionGroup    String?
  status          ImportImageStatus @default(queued)
  modelOutput     Json?
  fieldConfidence Json?
  error           String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  @@index([batchId, status])
  @@map("import_image")
}
