# Postgres (same provider as Paymavo). Use a separate database for Sinew.
DATABASE_URL="postgresql://user:password@host:5432/sinew"

# better-auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email OTP sign-in (Resend). In dev, if unset, the OTP is printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Sinew <login@sinew.fit>"

# Photo import (AI OCR) — same provider as Paymavo (Gemini vision)
GEMINI_API_KEY=""

# Private storage for notebook photos (Cloudinary, same as Paymavo)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
