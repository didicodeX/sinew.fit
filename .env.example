# Vercel scopes: Production (main -> sinew.fit) and Preview (staging -> staging.sinew.fit) use the SAME
# variable names with DIFFERENT values (separate Neon branch, separate BETTER_AUTH_SECRET, own NEXT_PUBLIC_APP_URL).
# Preview also sets MIGRATE_PREVIEW=true so staging migrations run against its own database only.

# Postgres (same provider as Paymavo). Use a separate database for Sinew.
DATABASE_URL="postgresql://user:password@host:5432/sinew"
# Optional: direct (non-pooled) URL used by prisma migrate, e.g. Neon's unpooled connection string
DIRECT_URL=""

# better-auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email OTP sign-in (Resend). In dev, if unset, the OTP is printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Sinew <login@sinew.fit>"

# Photo import (AI OCR) — same provider as Paymavo (Gemini vision)
GEMINI_API_KEY=""
# Optional: vision model id (default gemini-flash-latest)
GEMINI_MODEL=""
# Optional: comma-separated models tried when the main one is overloaded (503)
# (default gemini-flash-lite-latest,gemini-2.5-flash)
GEMINI_FALLBACK_MODELS=""

# Private storage for notebook photos (Cloudinary, same as Paymavo)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
