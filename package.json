{
  "name": "sinew",
  "version": "0.1.0",
  "description": "Calisthenics training log: plan, log, and track progression. Web-first PWA.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-on-deploy.mjs && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "check": "pnpm lint && pnpm type-check && pnpm test:run",
    "test": "vitest",
    "test:run": "vitest run",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "1.7.7",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dotenv": "^18.0.10",
    "next": "^16.4.6",
    "next-safe-action": "^8.7.3",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
